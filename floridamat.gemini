<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>State Rankings - Florida Wrestling</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 font-sans">

    <!-- Header -->
    <div class="bg-blue-800 text-white p-4">
        <div class="container mx-auto text-center">
            <h1 class="text-3xl font-bold mb-4"><a href="{% url 'home' %}">Florida Wrestling</a></h1>
            <div class="flex flex-wrap justify-center gap-4 text-sm">
                {% for link in header_links %}
                <a href="{{ link.url }}" class="hover:underline">{{ link.title }}</a>
                {% if not forloop.last %}<span>|</span>{% endif %}
                {% empty %}
                <a href="{% url 'home' %}" class="hover:underline">Home</a>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="container mx-auto p-4 grid grid-cols-1 md:grid-cols-12 gap-6">

        <!-- Left Sidebar -->
        <div class="md:col-span-3 space-y-6">
            <div class="bg-white p-4 rounded shadow">
                <h3 class="font-bold text-lg mb-2 border-b pb-1">Resources</h3>
                <ul class="space-y-2 text-sm">
                    {% for link in resource_links %}
                    <li><a href="{{ link.url }}" class="text-blue-700 hover:underline">{{ link.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div class="bg-white p-4 rounded shadow">
                <h3 class="font-bold text-lg mb-2 border-b pb-1">College Teams</h3>
                <ul class="space-y-2 text-sm">
                    {% for link in college_links %}
                    <li><a href="{{ link.url }}" class="text-blue-700 hover:underline">{{ link.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <!-- Center: Rankings Content -->
        <div class="md:col-span-9">
            <div class="bg-white p-6 rounded shadow">
                <h2 class="text-2xl font-bold text-red-700 mb-6 border-b pb-2">Current State Rankings</h2>

                <div class="flex space-x-2 mb-6">
                    <a href="{% url 'rankings' %}"
                        class="px-3 py-1 rounded text-sm font-bold {% if not current_classification %}bg-blue-800 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">All</a>
                    <a href="?classification=1A"
                        class="px-3 py-1 rounded text-sm font-bold {% if current_classification == '1A' %}bg-blue-800 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">1A</a>
                    <a href="?classification=2A"
                        class="px-3 py-1 rounded text-sm font-bold {% if current_classification == '2A' %}bg-blue-800 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">2A</a>
                    <a href="?classification=3A"
                        class="px-3 py-1 rounded text-sm font-bold {% if current_classification == '3A' %}bg-blue-800 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">3A</a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {% for weight, wrestlers in rankings_by_weight.items %}
                    <div class="border rounded p-4 bg-gray-50">
                        <h3 class="font-bold text-lg text-center bg-gray-200 p-1 mb-2 rounded">{{ weight }} lbs</h3>
                        <ol class="list-decimal list-inside space-y-1 text-sm">
                            {% for rank_obj in wrestlers %}
                            <li class="p-1 border-b border-gray-200 last:border-0">
                                <span class="font-semibold">{{ rank_obj.wrestler.first_name }} {{
                                    rank_obj.wrestler.last_name }}</span>
                                <span class="text-gray-600 text-xs ml-1">({{ rank_obj.wrestler.school.name }})</span>
                            </li>
                            {% endfor %}
                        </ol>
                    </div>
                    {% empty %}
                    <p>No rankings available at this time.</p>
                    {% endfor %}
                </div>

                <div class="mt-8 pt-4 border-t">
                    <a href="{% url 'home' %}" class="text-blue-600 hover:underline">&larr; Back to Home</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-gray-800 text-white text-center p-4 mt-8">
        <p>&copy; 2024 Florida Wrestling. All rights reserved.</p>
    </footer>
</body>

</html>